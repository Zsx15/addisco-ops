OPENAI_API_KEY=remplacer_par_ta_cle_api
# Optionnel : mot de passe d'application (laisser vide = accès libre / mode démo)
APP_PASSWORD=

# Rate limiting LLM — appels par utilisateur (valeurs par défaut si absent)
RATE_CHAT_PER_MINUTE=20
RATE_CHAT_PER_HOUR=200
RATE_EMBED_PER_MINUTE=30
RATE_EMBED_PER_HOUR=500

# Monitoring Sentry — laisser vide pour désactiver (aucun overhead)
SENTRY_DSN=
APP_ENV=production
APP_VERSION=1.0.0
